@page
@model Company.Product.Web.Pages.SampleItems.IndexModel
@{
    ViewData["Title"] = Localizer["SampleItems"];
}

<h2>@Localizer["SampleItems"]</h2>

<p>
    <a asp-page="/SampleItems/Create" class="btn btn-primary btn-sm">@Localizer["Create"]</a>
</p>

@if (Model.Items.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Description"]</th>
                <th>@Localizer["CreatedAt"]</th>
                <th>@Localizer["UpdatedAt"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <a asp-page="/SampleItems/Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">@Localizer["Edit"]</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('@Localizer["ConfirmDelete"]')">@Localizer["Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">@Localizer["NoItemsFound"]</p>
}
