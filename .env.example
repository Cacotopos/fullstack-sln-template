# Environment
ASPNETCORE_ENVIRONMENT=Development
APP_NAME=Company.Product
APP_BASE_URL=https://localhost:5001
API_BASE_URL=https://localhost:5001
WEB_BASE_URL=https://localhost:5002

# Seq (structured logging)
Seq__ServerUrl=http://localhost:5341

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=productdb
POSTGRES_USER=productuser
POSTGRES_PASSWORD=change-me
CONNECTION_STRINGS__DEFAULT=Host=localhost;Port=5432;Database=productdb;Username=productuser;Password=change-me
CONNECTION_STRINGS__ReadOnly=Host=localhost;Port=5432;Database=productdb;Username=productuser;Password=change-me
CONNECTION_STRINGS__AzureBlob=DefaultEndpointsProtocol=https;AccountName=mystorageaccount;AccountKey=myaccountkey;EndpointSuffix=core.windows.net

# JWT (API)
Jwt__Issuer=Company.Product
Jwt__Audience=Company.Product
Jwt__Key=your-super-secret-jwt-key-32-chars-min

# OAuth / Social Providers
Auth__Google__ClientId=
Auth__Google__ClientSecret=
Auth__Microsoft__ClientId=
Auth__Microsoft__ClientSecret=
Auth__Apple__ClientId=
Auth__Apple__TeamId=
Auth__Apple__KeyId=
Auth__Apple__PrivateKey=

# Stripe Payments
STRIPE__PUBLISHABLE_KEY=pk_test_...
STRIPE__SECRET_KEY=sk_test_...
STRIPE__WEBHOOK_SECRET=whsec_...
STRIPE__PRICE_ID_BASIC=price_...
STRIPE__PRICE_ID_PRO=price_...

# Authorization / RBAC
AUTH__DEFAULT_ADMIN_ROLE=Admin
AUTH__DEFAULT_EDITOR_ROLE=Editor
AUTH__DEFAULT_USER_ROLE=User
AUTH__DEFAULT_SERVICE_ROLE=ServiceIntegration

# Webhooks / integrations
WEBHOOKS__SIGNING_SECRET=change-me
WEBHOOKS__RETRY_COUNT=3
WEBHOOKS__RETRY_DELAY_SECONDS=5

# Observability
LOGGING__LEVEL=Information
TRACING__ENABLED=true
HEALTHCHECKS__ENABLED=true

# Netlify
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
NETLIFY_BUILD_COMMAND=npm run build
NETLIFY_PUBLISH_DIR=dist

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_CONNECTION=

# Deployment
DEPLOYMENT__ENVIRONMENT=local
DEPLOYMENT__MIGRATE_ON_STARTUP=false
DEPLOYMENT__SEED_ON_STARTUP=true
